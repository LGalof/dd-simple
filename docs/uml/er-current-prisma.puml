@startuml
title D&D Simple - Current Prisma ER Overview

top to bottom direction
hide circle
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam nodesep 24
skinparam ranksep 26
skinparam entity {
  BackgroundColor #FFFFF8
  BorderColor #333333
  FontColor #111111
}

package "REFERENCE DATA\nseeded / application-managed" as ReferenceData {
  entity "RefClass" as RefClass {
    * index : String <<PK>>
    --
    name : String
  }

  entity "RefSpecies" as RefSpecies {
    * index : String <<PK>>
    --
    name : String
  }

  entity "RefBackground" as RefBackground {
    * index : String <<PK>>
    --
    name : String
  }

  entity "RefEquipment" as RefEquipment {
    * index : String <<PK>>
    --
    name : String
  }

  entity "RefSkill" as RefSkill {
    * index : String <<PK>>
    --
    abilityIndex : String <<FK>>
    name : String
  }
}

package "USER & GAME DATA\nruntime / user-generated" as RuntimeData {
  entity "User" as User {
    * id : String <<PK>>
    --
    email : String <<unique>>
  }

  entity "Character" as Character {
    * id : String <<PK>>
    --
    userId : String <<FK>>
    name : String
    level : Int
    classIndex : String <<FK>>
    speciesIndex : String <<FK>>
    backgroundIndex : String <<FK>>
  }

  entity "Room" as Room {
    * id : String <<PK>>
    --
    code : String <<unique>>
    creatorUserId : String <<FK>>
    creatorCharacterId : String <<FK>>
  }

  entity "RoomPlayer" as RoomPlayer {
    * id : String <<PK>>
    --
    roomId : String <<FK>>
    userId : String <<FK>>
    characterId : String <<FK>>
  }

  entity "DiceRoll" as DiceRoll {
    * id : String <<PK>>
    --
    characterId : String <<FK>>
    roomId : String? <<FK>>
    rolledByUserId : String <<FK>>
    total : Int
  }
}

package "CHARACTER STATE\nruntime character selections / state" as CharacterState {
  entity "CharacterAbilityScore" as CharacterAbilityScore {
    * characterId : String <<PK, FK>>
    * abilityIndex : String <<PK, FK>>
    --
    score : Int
  }

  entity "CharacterInventory" as CharacterInventory {
    * id : String <<PK>>
    --
    characterId : String <<FK>>
    equipmentIndex : String <<FK>>
    quantity : Int
  }

  entity "CharacterChoice" as CharacterChoice {
    * id : String <<PK>>
    --
    characterId : String <<FK>>
    choiceType : String
    selectedIndex : String
  }

  entity "CharacterCondition" as CharacterCondition {
    * id : String <<PK>>
    --
    characterId : String <<FK>>
    conditionIndex : String <<FK>>
  }

  entity "CharacterSpellcastingState" as CharacterSpellcastingState {
    * id : String <<PK>>
    --
    characterId : String <<unique FK>>
    preparedSpellIds : Json?
    slotUsageByLevel : Json?
  }

  entity "CharacterResourceState" as CharacterResourceState {
    * id : String <<PK>>
    --
    characterId : String <<unique FK>>
    usageByResourceKey : Json?
    activeByResourceKey : Json?
  }
}

ReferenceData -[hidden]right- RuntimeData
RuntimeData -[hidden]right- CharacterState

RefClass -[hidden]right- RefSpecies
RefSpecies -[hidden]right- RefBackground
RefEquipment -[hidden]right- RefSkill
RefClass -[hidden]down- RefEquipment

User -[hidden]down- Character
Character -[hidden]down- Room
Room -[hidden]right- RoomPlayer
RoomPlayer -[hidden]right- DiceRoll

CharacterAbilityScore -[hidden]right- CharacterInventory
CharacterInventory -[hidden]right- CharacterChoice
CharacterCondition -[hidden]right- CharacterSpellcastingState
CharacterSpellcastingState -[hidden]right- CharacterResourceState
CharacterAbilityScore -[hidden]down- CharacterCondition

RefClass -right-> Character
RefSpecies -right-> Character
RefBackground -right-> Character
RefEquipment -right-> CharacterInventory

User -right-> Character
User -down-> Room
User -right-> DiceRoll
Room -right-> RoomPlayer
Room -right-> DiceRoll
Character -down-> RoomPlayer
Character -down-> DiceRoll

Character -right-> CharacterAbilityScore
Character -right-> CharacterInventory
Character -right-> CharacterChoice
Character -right-> CharacterCondition
Character -right-> CharacterSpellcastingState
Character -right-> CharacterResourceState

legend bottom
Reference data = seeded/application-managed D&D rules data.
Runtime data = data created or changed during application use.
Character state = runtime selections and per-character state connected to Character.
Additional Ref* and specialized Character* models are omitted for readability.
schema.prisma remains the complete database schema.
endlegend
@enduml
