{
  "name": "@dd-simple/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node ../../node_modules/tsx/dist/cli.mjs src/index.ts",
    "build": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json",
    "test": "npm --prefix ../.. --workspace @dd-simple/shared run build && node --import tsx --test \"src/**/*.test.ts\"",
    "test:coverage": "npm --prefix ../.. --workspace @dd-simple/shared run build && c8 --reporter=text --reporter=lcov node --import tsx --test \"src/**/*.test.ts\" && node ../../scripts/prefix-lcov-paths.mjs coverage/lcov.info apps/api",
    "start": "node dist/index.js",
    "audit:class-feature-choices": "node ../../node_modules/tsx/dist/cli.mjs src/scripts/auditClassFeatureChoices.ts",
    "prisma:generate": "node ../../node_modules/prisma/build/index.js generate",
    "prisma:migrate": "node ../../node_modules/prisma/build/index.js migrate dev",
    "prisma:migrate:deploy": "node ../../node_modules/prisma/build/index.js migrate deploy",
    "prisma:studio": "node ../../node_modules/prisma/build/index.js studio",
    "prisma:seed": "node ../../node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "seed:demo": "node ../../node_modules/tsx/dist/cli.mjs prisma/seed-local-demo.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.0",
    "c8": "^12.0.0",
    "prisma": "^6.8.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "prisma": {
    "seed": "node ../../node_modules/tsx/dist/cli.mjs prisma/seed.ts"
  }
}
